#!/usr/bin/env zsh

emulate -L zsh
setopt local_options pipefail

if [[ "${1:-}" == "--" ]]; then
  shift
fi

input="$*"
if [[ -z "${input//[[:space:]]/}" ]]; then
  print -u2 -- "usage: codex-shell-proxy -- <natural language request>"
  exit 2
fi

__codex_shell_normalize() {
  emulate -L zsh
  local text="${1:l}"
  text="${text//[?!.]/}"
  text="${text//_/ }"
  text="${text#"${text%%[![:space:]]*}"}"
  text="${text%"${text##*[![:space:]]}"}"
  print -r -- ${(j: :)${(z)text}}
}

__codex_shell_print_app_process_status() {
  emulate -L zsh
  setopt local_options pipefail extended_glob

  local query="$1"
  local query_key app_path executable process_path comm comm_key
  query_key="$(__codex_shell_app_key "$query")"
  [[ -n "$query_key" ]] || return 1

  case "$query_key" in
    it|this|that|anything|something|process|app|application)
      return 1
      ;;
  esac

  app_path="$(__codex_shell_resolve_app_bundle "$query_key")"
  if [[ -n "$app_path" ]]; then
    executable="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleExecutable' "$app_path/Contents/Info.plist" 2>/dev/null)"
    [[ -n "$executable" ]] || executable="${app_path:t:r}"
    process_path="$app_path/Contents/MacOS/$executable"

    if command ps -axo comm= 2>/dev/null | command grep -F -- "$process_path" >/dev/null 2>&1; then
      print -r -- 'running'
    else
      print -r -- 'not_running'
    fi
    __codex_shell_fast_path_exit=0
    return 0
  fi

  while IFS= read -r comm; do
    comm_key="$(__codex_shell_app_key "${comm:t}")"
    if [[ "$comm_key" == "$query_key" || "$comm_key" == *" $query_key" ]]; then
      print -r -- 'running'
      __codex_shell_fast_path_exit=0
      return 0
    fi
  done < <(command ps -axo comm= 2>/dev/null)

  print -r -- 'not_running'
  __codex_shell_fast_path_exit=0
  return 0
}

__codex_shell_app_key() {
  emulate -L zsh
  setopt local_options extended_glob

  local text="${1:l}"
  text="${text:r}"
  text="${text//&/ and }"
  text="${text//[-_.]/ }"
  text="${text//[^[:alnum:][:space:]]/ }"
  text="${(j: :)${(z)text}}"
  text="${text#the }"
  text="${text#app }"
  text="${text% app}"
  text="${text% application}"
  print -r -- "$text"
}

__codex_shell_resolve_app_bundle() {
  emulate -L zsh
  setopt local_options extended_glob

  local query_key="$1"
  local -a app_dirs
  local app_dir app_path app_name app_key suffix_path=''
  integer suffix_matches=0

  app_dirs=(
    /Applications
    "$HOME/Applications"
    /Applications/Utilities
    /System/Applications
    /System/Applications/Utilities
  )

  for app_dir in "${app_dirs[@]}"; do
    [[ -d "$app_dir" ]] || continue
    for app_path in "$app_dir"/*.app(N); do
      [[ "${app_path:t}" == .* ]] && continue
      app_name="${app_path:t:r}"
      app_key="$(__codex_shell_app_key "$app_name")"

      if [[ "$app_key" == "$query_key" ]]; then
        print -r -- "$app_path"
        return 0
      fi

      if [[ "$app_key" == *" $query_key" ]]; then
        suffix_path="$app_path"
        (( suffix_matches++ ))
      fi
    done
  done

  if (( suffix_matches == 1 )); then
    print -r -- "$suffix_path"
    return 0
  fi

  return 1
}

__codex_shell_extract_process_status_query() {
  emulate -L zsh

  local text="$1" query=''
  text="${text% right now}"
  text="${text% rn}"
  text="${text// currently / }"
  text="${text// still / }"

  case "$text" in
    can\ you\ check\ if\ *\ is\ running)
      query="${text#can you check if }"
      query="${query% is running}"
      ;;
    can\ you\ check\ if\ *\ is\ open)
      query="${text#can you check if }"
      query="${query% is open}"
      ;;
    can\ you\ see\ if\ *\ is\ running)
      query="${text#can you see if }"
      query="${query% is running}"
      ;;
    can\ you\ see\ if\ *\ is\ open)
      query="${text#can you see if }"
      query="${query% is open}"
      ;;
    check\ if\ *\ is\ running|see\ if\ *\ is\ running)
      query="${text#* if }"
      query="${query% is running}"
      ;;
    check\ if\ *\ is\ open|see\ if\ *\ is\ open)
      query="${text#* if }"
      query="${query% is open}"
      ;;
    do\ i\ have\ *\ running)
      query="${text#do i have }"
      query="${query% running}"
      ;;
    is\ there\ a\ *\ process)
      query="${text#is there a }"
      query="${query% process}"
      ;;
    is\ the\ *\ process\ running)
      query="${text#is the }"
      query="${query% process running}"
      ;;
    is\ *\ process\ running)
      query="${text#is }"
      query="${query% process running}"
      ;;
    is\ *\ running)
      query="${text#is }"
      query="${query% running}"
      ;;
    is\ *\ open)
      query="${text#is }"
      query="${query% open}"
      ;;
    *\ process\ running)
      query="${text% process running}"
      ;;
    *\ running)
      query="${text% running}"
      ;;
    *\ open)
      query="${text% open}"
      ;;
  esac

  query="${query#the }"
  query="${query#app }"
  query="${query% app}"
  query="${query% application}"
  print -r -- "$query"
}

__codex_shell_run_process_status_fast_path() {
  emulate -L zsh
  setopt local_options extended_glob

  local normalized="$1"
  local query="$(__codex_shell_extract_process_status_query "$normalized")"

  [[ -n "$query" ]] || return 1
  [[ "$query" != "$normalized" ]] || return 1
  __codex_shell_print_app_process_status "$query"
  return $?

  return 1
}

__codex_shell_run_fast_path() {
  emulate -L zsh
  setopt local_options pipefail

  local raw="$1"
  local normalized command_text target
  normalized="$(__codex_shell_normalize "$raw")"

  if __codex_shell_run_process_status_fast_path "$normalized"; then
    return 0
  fi

  case "$normalized" in
    "can you ls"|"can you list"|"can you list files"|"list files"|"show files"|"run ls")
      command_text='ls'
      ;;
    "can you ls -1"|"can you list one per line"|"list files one per line")
      command_text='ls -1'
      ;;
    "can you pwd"|"run pwd"|"pwd"|"where am i"|"what folder am i in"|"what directory am i in")
      command_text='pwd'
      ;;
    "show jj status"|"jj status"|"show my jj status")
      command -v jj >/dev/null 2>&1 || return 1
      command_text='jj status'
      ;;
    "show my jj changes"|"show jj changes"|"show changes")
      command -v jj >/dev/null 2>&1 || return 1
      jj root --ignore-working-copy >/dev/null 2>&1 || return 1
      command_text='jj diff'
      ;;
    "show git status"|"git status"|"show my git status")
      command -v git >/dev/null 2>&1 || return 1
      command_text='git status --short --branch'
      ;;
  esac

  if [[ -z "${command_text:-}" ]]; then
    if [[ "$normalized" == (can\ you\ see\ what\ is\ in|what\ is\ in|show\ what\ is\ in|list\ what\ is\ in)\ * ]]; then
      target="${normalized##* in }"
      case "$target" in
        repos)
          [[ -d "$HOME/repos" ]] || return 1
          command_text="ls -1 ${(q)HOME}/repos"
          ;;
        downloads)
          [[ -d "$HOME/Downloads" ]] || return 1
          command_text="ls -1 ${(q)HOME}/Downloads"
          ;;
        desktop)
          [[ -d "$HOME/Desktop" ]] || return 1
          command_text="ls -1 ${(q)HOME}/Desktop"
          ;;
        documents)
          [[ -d "$HOME/Documents" ]] || return 1
          command_text="ls -1 ${(q)HOME}/Documents"
          ;;
        here|this\ folder|this\ directory)
          command_text='ls -1'
          ;;
      esac
    fi
  fi

  [[ -n "${command_text:-}" ]] || return 1

  if [[ "${CODEX_SHELL_SHOW_COMMANDS:-0}" == "1" ]]; then
    print -r -- "$ $command_text"
  fi
  eval "$command_text"
  __codex_shell_fast_path_exit=$?
  return 0
}

if [[ "${CODEX_SHELL_FAST_PATH:-1}" != "0" ]] && __codex_shell_run_fast_path "$input"; then
  exit "${__codex_shell_fast_path_exit:-0}"
fi

if [[ "${CODEX_SHELL_TEST_FAST_PATH_ONLY:-0}" == "1" ]]; then
  exit 64
fi

model="${CODEX_SHELL_MODEL:-gpt-5.3-codex-spark}"
reasoning="${CODEX_SHELL_REASONING:-low}"

if [[ "${CODEX_SHELL_WARM:-1}" != "0" && "${CODEX_SHELL_SEARCH:-0}" != "1" ]] && command -v codex-shell-daemon >/dev/null 2>&1; then
  daemon_args=(
    request
    --cwd "$PWD"
    --model "$model"
    --effort "$reasoning"
  )

  [[ "${CODEX_SHELL_YOLO:-0}" == "1" ]] && daemon_args+=(--yolo)
  [[ "${CODEX_SHELL_SHOW_COMMANDS:-0}" == "1" ]] && daemon_args+=(--show-commands)

  codex-shell-daemon "${daemon_args[@]}" -- "$input"
  daemon_exit=$?
  if [[ "$daemon_exit" != "69" || "${CODEX_SHELL_WARM_FALLBACK:-1}" == "0" ]]; then
    exit "$daemon_exit"
  fi
  print -u2 -- "[codex-shell] warm daemon unavailable; falling back to codex exec."
fi

lockdir="${CODEX_SHELL_LOCKDIR:-$HOME/.cache/codex-shell-proxy.lock}"
prompt_file=''
json_file=''
last_message_file=''
had_command=0

mkdir -p -- "${lockdir:h}" 2>/dev/null || true
if ! mkdir -- "$lockdir" 2>/dev/null; then
  print -u2 -- "[codex-shell] Codex is busy; try again in a few seconds."
  exit 75
fi

cleanup() {
  [[ -n "$prompt_file" && -f "$prompt_file" ]] && rm -f -- "$prompt_file"
  [[ -n "$json_file" && -f "$json_file" ]] && rm -f -- "$json_file"
  [[ -n "$last_message_file" && -f "$last_message_file" ]] && rm -f -- "$last_message_file"
  rmdir -- "$lockdir" 2>/dev/null || true
}
trap cleanup EXIT INT TERM HUP

repo_kind='none'

if command -v jj >/dev/null 2>&1; then
  jj_root=$(command jj root --ignore-working-copy 2>/dev/null)
  if [[ -n "${jj_root:-}" ]]; then
    repo_kind='jj'
  fi
fi

if [[ "$repo_kind" != "jj" ]] && command git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  repo_kind='git'
fi

prompt_file=$(mktemp "${TMPDIR:-/tmp}/codex-shell-prompt.XXXXXX") || exit 1
cat >| "$prompt_file" <<EOF
You are running as Ahmed's fast terminal assistant inside macOS zsh.

The user typed a line that was not recognized as a direct shell command. Interpret it as natural language and handle it now.

Behavior:
- Be fast and concise.
- Only do what the user asked.
- Do not inspect or print repo status unless it helps satisfy the user request.
- Run straightforward shell/repo commands directly when useful.
- Prefer jj/Jujutsu over git when the current directory is in a jj repo.
- Avoid destructive actions unless the user explicitly asked for them.
- If an action is ambiguous or risky, ask one short question instead of guessing.
- For code review requests, use a code-review stance: findings first, ordered by severity.
- Do not narrate before straightforward command execution; run the command first.
- If you run a command that answers the request, do not add a final explanation.
- Only produce a final text answer when you did not run a command or the user explicitly asked for explanation.
- Keep final responses short.
- Do not explain this routing layer unless the user asks.

Environment:
- cwd: $PWD
- shell: zsh
- repo_kind: $repo_kind
- model requested by wrapper: $model

User input:
$input
EOF

codex_args=()
if [[ "${CODEX_SHELL_SEARCH:-0}" == "1" ]]; then
  codex_args+=(--search)
fi

codex_args+=(
  exec
  --skip-git-repo-check
  -C "$PWD"
  -m "$model"
  -c "model_reasoning_effort=\"$reasoning\""
)

if [[ "${CODEX_SHELL_YOLO:-0}" == "1" ]]; then
  codex_args+=(--dangerously-bypass-approvals-and-sandbox)
else
  codex_args+=(--full-auto)
fi

print -u2 -- "$model is thinking...."
if command -v jq >/dev/null 2>&1; then
  json_file=$(mktemp "${TMPDIR:-/tmp}/codex-shell-json.XXXXXX") || exit 1
  last_message_file=$(mktemp "${TMPDIR:-/tmp}/codex-shell-last.XXXXXX") || exit 1

  command codex "${codex_args[@]}" --json -o "$last_message_file" - < "$prompt_file" >| "$json_file" 2>&1
  codex_exit=$?

  while IFS= read -r line; do
    [[ "$line" == *"ERROR codex_core::session: failed to record rollout items:"* ]] && continue

    if [[ "$line" != \{* ]]; then
      print -u2 -- "$line"
      continue
    fi

    event_type=$(jq -r '.type // empty' 2>/dev/null <<< "$line")
    case "$event_type" in
      item.completed)
        item_type=$(jq -r '.item.type // empty' 2>/dev/null <<< "$line")
        case "$item_type" in
          command_execution)
            had_command=1
            command_text=$(jq -r '.item.command // empty' 2>/dev/null <<< "$line")
            output_text=$(jq -r '.item.aggregated_output // empty' 2>/dev/null <<< "$line")
            exit_code=$(jq -r '.item.exit_code // empty' 2>/dev/null <<< "$line")

            if [[ "${CODEX_SHELL_SHOW_COMMANDS:-0}" == "1" && -n "$command_text" ]]; then
              print -r -- "$ $command_text"
            fi
            [[ -n "$output_text" ]] && print -rn -- "$output_text"
            if [[ -n "$exit_code" && "$exit_code" != "0" ]]; then
              print -u2 -- "[codex-shell] command exited with $exit_code"
            fi
            ;;
        esac
        ;;
    esac
  done < "$json_file"

  if (( ! had_command )) && [[ -s "$last_message_file" ]]; then
    print -r -- ''
    cat -- "$last_message_file"
  fi

  exit "$codex_exit"
else
  command codex "${codex_args[@]}" - < "$prompt_file"
fi
